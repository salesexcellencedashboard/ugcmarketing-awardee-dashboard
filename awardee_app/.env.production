#--------------------------------------------------------------------
# AWARDEE System Environment Configuration - PRODUCTION
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'https://your-domain.vercel.app/'

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
# Update these with your production database credentials
# For MySQL/MariaDB hosted service (e.g., PlanetScale, AWS RDS, etc.)

database.default.hostname = ${DB_HOST}
database.default.database = ${DB_NAME}
database.default.username = ${DB_USER}
database.default.password = ${DB_PASSWORD}
database.default.DBDriver = MySQLi
database.default.port = ${DB_PORT}
database.default.DBPrefix =
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

encryption.key = ${ENCRYPTION_KEY}
encryption.driver = OpenSSL

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

session.driver = database
session.cookieName = AWARDEE_SESSION
session.expiration = 7200
session.savePath = awardee_sessions
