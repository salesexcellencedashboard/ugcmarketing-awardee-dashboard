#--------------------------------------------------------------------
# AWARDEE PERFORMANCE MANAGEMENT SYSTEM
# Environment Configuration Template
#--------------------------------------------------------------------
# This file shows all available configuration options.
# Copy this to .env and update values for your environment.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
# Options: development, staging, production
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APPLICATION
#--------------------------------------------------------------------
# The base URL of your application
# For local: http://localhost:8084/
# For production: https://your-domain.com/
app.baseURL = 'http://localhost:8084/'

#--------------------------------------------------------------------
# ADMIN USER CREDENTIALS
#--------------------------------------------------------------------
# Used by DatabaseSeeder during initial setup
# ADMIN_PASSWORD must be at least 8 characters
ADMIN_USERNAME = awardeeadmin
ADMIN_EMAIL = admin@awardee.local
ADMIN_PASSWORD = AwardeeAdmin2026!

#--------------------------------------------------------------------
# DATABASE CONFIGURATION
#--------------------------------------------------------------------
# OPTION 1: MySQL/MariaDB (Local Development)
database.default.hostname = 127.0.0.1
database.default.database = awardee_system
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3306

# OPTION 2: Oracle Database (Production)
# Uncomment and update the following for Oracle deployment:
# database.default.hostname = oracle-server.domain.com
# database.default.database = AWARDEE
# database.default.username = awardee_user
# database.default.password = your_oracle_password
# database.default.DBDriver = OCI8
# database.default.port = 1521
# database.default.charset = UTF8

# Common database settings
database.default.DBPrefix =
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

#--------------------------------------------------------------------
# SECURITY & SESSION
#--------------------------------------------------------------------
# Session storage method
session.sessionDriver = database
session.sessionCookieName = AWARDSESSID
session.sessionExpiration = 7200

# CSRF Protection
security.tokenRandomize = true
security.csrfProtection = cookie

#--------------------------------------------------------------------
# FILE UPLOADS
#--------------------------------------------------------------------
# Maximum file size in bytes (50MB default)
maxFileSize = 52428800
# Upload directory (relative to public folder)
uploadPath = writable/uploads/

#--------------------------------------------------------------------
# LOGGING
#--------------------------------------------------------------------
# Log threshold: 0=emergency, 1=alert, 2=critical, 3=error, 
#               4=warning, 5=notice, 6=info, 7=debug
log.threshold = 4
log.logPath = writable/logs/

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------
# Encryption key (generate a strong random key for production)
# Leave empty for development, must be set for production
encryption.key = 
encryption.driver = OpenSSL

#--------------------------------------------------------------------
# CACHE SETTINGS
#--------------------------------------------------------------------
cache.handler = file
cache.storePath = writable/cache/

#--------------------------------------------------------------------
# DEBUGGING
#--------------------------------------------------------------------
# Enable/Disable debug toolbar (should be OFF in production)
debugbar.enabled = true
session.savePath = /var/www/awardee/writable/session

#--------------------------------------------------------------------
# ADMIN USER (used by AdminUserSeeder)
#--------------------------------------------------------------------
# Set these before running: php spark db:seed DatabaseSeeder
# ADMIN_PASSWORD is REQUIRED and must be at least 8 characters

ADMIN_USERNAME = awardeeadmin
ADMIN_EMAIL = admin@awardee.local
ADMIN_PASSWORD = CHANGE_THIS_STRONG_ADMIN_PASSWORD